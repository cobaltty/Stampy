<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="StampyWindow" parent="AdwApplicationWindow">
    <property name="title"></property>
    <property name="default-width">1250</property>
    <property name="default-height">800 </property>
    <child>
      <object class="AdwToolbarView">

        <child type="top">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <child>
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkButton" id="btn_header_clear">
                    <property name="icon-name">user-trash-symbolic</property>
                    <property name="tooltip-text">Remove All</property>
                    <style><class name="destructive-action"/></style>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkMenuButton" id="btn_menu">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="primary">true</property>
                    <property name="tooltip-text">Menu</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <!-- Cancel button (hidden unless an export is running) -->
                    <child>
                      <object class="GtkButton" id="btn_header_cancel">
                        <property name="icon-name">media-playback-stop-symbolic</property>
                        <property name="tooltip-text">Cancel Export</property>
                        <property name="visible">false</property>
                        <style><class name="destructive-action"/></style>
                      </object>
                    </child>
                      <!-- Export button -->
                    <child>
                      <object class="GtkButton" id="btn_header_export">
                        <property name="icon-name">export-symbolic</property>
                        <property name="tooltip-text">Export Final Output</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkProgressBar" id="progress_bar">
                <property name="visible">false</property>
                <style>
                  <class name="osd"/>
                </style>
              </object>
            </child>
            <child>
              <object class="AdwBanner" id="banner_landscape">
                <property name="title">Warning: Some photos are in horizontal (landscape) position</property>
                <property name="button-label">See more</property>
                <property name="revealed">false</property>
              </object>
            </child>
            <child>
              <object class="AdwBanner" id="banner_missing_data">
                <property name="title">Warning: Expected data missing</property>
                <property name="button-label">See details</property>
                <property name="revealed">false</property>
              </object>
            </child>
            <child>
              <object class="AdwBanner" id="banner_critical_coords">
                <property name="title">Critical: Missing coordinates</property>
                <property name="button-label">See details</property>
                <property name="revealed">false</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="GtkBox">
                <property name="orientation">0</property>
                <property name="spacing">16</property>
                <property name="margin-top">16</property>
                <property name="margin-bottom">16</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>

                <!-- Left column -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="spacing">12</property>
                    <property name="width-request">320</property>
                    <property name="hexpand">false</property>

                    <child>
                      <object class="GtkStack" id="left_stack">
                        <property name="transition-type">2</property>
                        <property name="vexpand">true</property>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">page_drop</property>
                            <property name="child">
                              <object class="GtkButton" id="drop_area_frame">
                                <style><class name="card"/><class name="flat"/></style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="halign">3</property>
                                    <property name="valign">3</property>
                                    <property name="spacing">12</property>
                                    <property name="can-target">false</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">arrow-into-box-symbolic</property>
                                        <property name="pixel-size">64</property>
                                      </object>
                                    </child>
                                    <child><object class="GtkLabel"><property name="label">Add Images</property><style><class name="title-4"/></style></object></child>
                                    <child><object class="GtkLabel"><property name="label">Import by clicking or drag here</property><property name="justify">2</property><style><class name="dim-label"/></style></object></child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">page_list</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox" id="box_pu_selector">
                                    <property name="orientation">0</property>
                                    <property name="spacing">6</property>
                                    <property name="margin-start">8</property>
                                    <property name="margin-end">8</property>
                                    <property name="margin-top">8</property>
                                    <property name="margin-bottom">4</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkDropDown" id="drop_pu_folder">
                                        <property name="hexpand">true</property>
                                        <property name="tooltip-text">Select PU Folder</property>
                                        <property name="model">
                                          <object class="GtkStringList"/>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="vexpand">true</property>
                                    <property name="hscrollbar-policy">2</property>
                                    <child>
                                      <object class="GtkListBox" id="file_listbox">
                                        <property name="selection-mode">3</property>
                                        <style><class name="navigation-sidebar"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                      </object>
                    </child>

                    <!-- Compass button with lock overlay -->
                    <child>
                      <object class="GtkOverlay">
                        <!-- Main button (full width) -->
                        <child>
                          <object class="GtkButton" id="btn_compass">
                            <property name="height-request">50</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <property name="halign">center</property>
                                <property name="can-target">false</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">folder-symbolic</property>
                                  </object>
                                </child>
                                <child><object class="GtkLabel" id="lbl_compass"><property name="label">Add Compass</property><property name="ellipsize">3</property></object></child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Lock toggle, overlaid on the left edge -->
                        <child type="overlay">
                          <object class="GtkToggleButton" id="btn_compass_lock">
                            <property name="halign">start</property>
                            <property name="valign">fill</property>
                            <property name="width-request">50</property>
                            <property name="icon-name">padlock2-symbolic</property>
                            <property name="tooltip-text">Lock Compass</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="btn_watermark">
                        <property name="height-request">50</property>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <property name="halign">center</property>
                            <property name="can-target">false</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">upload-symbolic</property>
                              </object>
                            </child>
                            <child><object class="GtkLabel" id="lbl_watermark"><property name="label">Add Watermark(.docx)</property><property name="ellipsize">3</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="btn_geolocation">
                        <property name="height-request">50</property>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">8</property>
                            <property name="halign">center</property>
                            <property name="can-target">false</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">upload-symbolic</property>
                              </object>
                            </child>
                            <child><object class="GtkLabel" id="lbl_geolocation"><property name="label">Add Geolocation(.xlsx)</property><property name="ellipsize">3</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>

                <!-- Right area -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="spacing">12</property>
                    <property name="hexpand">true</property>

                    <child>
                      <object class="GtkBox">
                        <property name="orientation">0</property>
                        <property name="spacing">12</property>
                        <property name="vexpand">true</property>

                        <!-- Preview -->
                        <child>
                          <object class="GtkFrame">
                            <style><class name="card"/></style>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkStack" id="preview_stack">
                                <property name="transition-type">4</property>

                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">single</property>
                                    <property name="child">
                                      <object class="GtkPicture" id="img_preview"><property name="vexpand">true</property><property name="content-fit">1</property></object>
                                    </property>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">multi</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="halign">3</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">dialog-warning-symbolic</property>
                                            <property name="pixel-size">64</property>
                                          </object>
                                        </child>
                                        <child><object class="GtkLabel"><property name="label">Preview only available&#10;one at the time</property><property name="justify">2</property><style><class name="heading"/></style></object></child>
                                      </object>
                                    </property>
                                  </object>
                                </child>

                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Settings panel -->
                        <child>
                          <object class="GtkBox" id="box_right_panel">
                            <property name="orientation">1</property>
                            <property name="width-request">360</property>
                            <property name="hexpand">false</property>

                            <child>
                              <object class="GtkFrame">
                                <style><class name="card"/></style>
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <property name="spacing">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>

                                    <!-- Compass row 1 -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child><object class="GtkLabel"><property name="label">Adjust Compass</property><property name="halign">1</property><style><class name="heading"/></style></object></child>
                                        <child>
                                          <object class="GtkDropDown" id="drop_compass_pos">
                                            <property name="hexpand">true</property>
                                            <property name="selected">0</property>
                                            <property name="model">
                                              <object class="GtkStringList">
                                                <items>
                                                  <item>UpLeft</item>
                                                  <item>UpRight</item>
                                                  <item>DownLeft</item>
                                                  <item>DownRight</item>
                                                </items>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <style><class name="linked"/></style>
                                            <child><object class="GtkToggleButton" id="btn_c_align_left"><property name="icon-name">format-justify-left-symbolic</property><property name="active">true</property></object></child>
                                            <child><object class="GtkToggleButton" id="btn_c_align_center"><property name="icon-name">format-justify-center-symbolic</property><property name="group">btn_c_align_left</property></object></child>
                                            <child><object class="GtkToggleButton" id="btn_c_align_right"><property name="icon-name">format-justify-right-symbolic</property><property name="group">btn_c_align_left</property></object></child>
                                          </object>
                                        </child>
                                        <!-- Compass size -->
                                        <child>
                                          <object class="GtkSpinButton" id="val_compass_size"><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">500</property><property name="step-increment">1</property></object></property><property name="value">140</property></object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Compass row 2 -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkBox">
                                             <style><class name="linked"/></style>
                                             <child><object class="GtkToggleButton" id="btn_c_shadow"><property name="icon-name">format-text-shadow-symbolic</property></object></child>
                                             <child><object class="GtkToggleButton" id="btn_c_stroke"><property name="icon-name">format-text-outline-symbolic</property></object></child>
                                           </object>
                                        </child>
                                        <child><object class="GtkColorButton" id="btn_c_stroke_color"><property name="tooltip-text">Compass Stroke Color</property><property name="rgba">rgb(0,0,0)</property></object></child>
                                        <child><object class="GtkBox"><property name="hexpand">true</property></object></child>

                                         <!-- Margin X -->
                                         <child>
                                           <object class="GtkBox">
                                             <property name="spacing">4</property>
                                             <child><object class="GtkImage"><property name="icon-name">expand-horizontal-symbolic</property><property name="tooltip-text">Margin X (px)</property><style><class name="dim-label"/></style></object></child>
                                              <child><object class="GtkSpinButton" id="val_compass_margin_x"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">500</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">20</property></object></child>
                                            </object>
                                          </child>
                                          <!-- Margin Y -->
                                          <child>
                                            <object class="GtkBox">
                                              <property name="spacing">4</property>
                                              <child><object class="GtkImage"><property name="icon-name">expand-vertical-symbolic</property><property name="tooltip-text">Margin Y (px)</property><style><class name="dim-label"/></style></object></child>
                                              <child><object class="GtkSpinButton" id="val_compass_margin_y"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">500</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">20</property></object></child>
                                           </object>
                                         </child>
                                        <!-- Opacity -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">4</property>
                                            <child><object class="GtkImage"><property name="icon-name">transparent-background-symbolic</property><property name="tooltip-text">Opacity (%)</property><style><class name="dim-label"/></style></object></child>
                                            <child><object class="GtkSpinButton" id="val_compass_opacity"><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">1</property></object></property><property name="value">77</property></object></child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <child><object class="GtkSeparator"/></child>

                                    <!-- Text row 1 -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child><object class="GtkLabel"><property name="label">Adjust Text</property><property name="halign">1</property><style><class name="heading"/></style></object></child>
                                        <child>
                                          <object class="GtkDropDown" id="drop_text_pos">
                                            <property name="hexpand">true</property>
                                            <property name="selected">3</property>
                                            <property name="model">
                                              <object class="GtkStringList">
                                                <items>
                                                  <item>UpLeft</item>
                                                  <item>UpRight</item>
                                                  <item>DownLeft</item>
                                                  <item>DownRight</item>
                                                </items>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                          <child>
                                            <object class="GtkBox">
                                              <style><class name="linked"/></style>
                                              <child><object class="GtkToggleButton" id="btn_t_align_left"><property name="icon-name">format-justify-left-symbolic</property></object></child>
                                              <child><object class="GtkToggleButton" id="btn_t_align_center"><property name="icon-name">format-justify-center-symbolic</property><property name="group">btn_t_align_left</property></object></child>
                                              <child><object class="GtkToggleButton" id="btn_t_align_right"><property name="icon-name">format-justify-right-symbolic</property><property name="group">btn_t_align_left</property><property name="active">true</property></object></child>
                                            </object>
                                          </child>
                                           <!-- Text size -->
                                           <child>
                                             <object class="GtkSpinButton" id="val_text_size"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">1</property><property name="upper">200</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">29</property></object>
                                           </child>
                                         </object>
                                      </child>

                                      <!-- Text row 2 -->
                                      <child>
                                        <object class="GtkBox">
                                          <property name="spacing">8</property>
                                          <child><object class="GtkBox"><property name="hexpand">true</property></object></child>
                                          <!-- Line spacing -->
                                          <child>
                                            <object class="GtkBox">
                                              <property name="spacing">4</property>
                                              <child><object class="GtkImage"><property name="icon-name">format-line-spacing-symbolic</property><property name="tooltip-text">Line Spacing (px)</property><style><class name="dim-label"/></style></object></child>
                                               <child><object class="GtkSpinButton" id="val_text_spacing"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">-100</property><property name="upper">200</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">12</property></object></child>
                                            </object>
                                          </child>
                                          <!-- Text margin X -->
                                          <child>
                                            <object class="GtkBox">
                                              <property name="spacing">4</property>
                                              <child><object class="GtkImage"><property name="icon-name">expand-horizontal-symbolic</property><property name="tooltip-text">Margin X (px)</property><style><class name="dim-label"/></style></object></child>
                                               <child><object class="GtkSpinButton" id="val_text_margin_x"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">500</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">20</property></object></child>
                                            </object>
                                          </child>
                                          <!-- Text margin Y -->
                                          <child>
                                            <object class="GtkBox">
                                              <property name="spacing">4</property>
                                              <child><object class="GtkImage"><property name="icon-name">expand-vertical-symbolic</property><property name="tooltip-text">Margin Y (px)</property><style><class name="dim-label"/></style></object></child>
                                               <child><object class="GtkSpinButton" id="val_text_margin_y"><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">500</property><property name="step-increment">0.1</property><property name="page-increment">1</property></object></property><property name="value">20</property></object></child>
                                            </object>
                                          </child>
                                        <!-- Text opacity -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">4</property>
                                            <child><object class="GtkImage"><property name="icon-name">transparent-background-symbolic</property><property name="tooltip-text">Opacity (%)</property><style><class name="dim-label"/></style></object></child>
                                            <child><object class="GtkSpinButton" id="val_text_opacity"><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">1</property></object></property><property name="value">100</property></object></child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Text style -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkDropDown" id="drop_text_font">
                                            <property name="hexpand">true</property>
                                            <property name="model">
                                              <object class="GtkStringList">
                                                <items>
                                                  <item>Arial</item>
                                                  <item>Times New Roman</item>
                                                  <item>JetBrains Mono</item>
                                                </items>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child><object class="GtkColorButton" id="btn_t_color"><property name="rgba">rgb(255,255,255)</property></object></child>

                                        <child>
                                          <object class="GtkBox">
                                            <style><class name="linked"/></style>
                                            <child><object class="GtkToggleButton" id="btn_t_bold"><property name="icon-name">format-text-bold-symbolic</property><property name="tooltip-text">Bold</property></object></child>
                                            <child><object class="GtkToggleButton" id="btn_t_italic"><property name="icon-name">format-text-italic-symbolic</property><property name="tooltip-text">Italic</property></object></child>
                                            <child><object class="GtkToggleButton" id="btn_t_underline"><property name="icon-name">format-text-underline-symbolic</property><property name="tooltip-text">Underline</property></object></child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <style><class name="linked"/></style>
                                            <child><object class="GtkToggleButton" id="btn_t_shadow"><property name="icon-name">format-text-shadow-symbolic</property></object></child>
                                            <child><object class="GtkToggleButton" id="btn_t_stroke"><property name="icon-name">format-text-outline-symbolic</property></object></child>
                                          </object>
                                        </child>
                                        <child><object class="GtkColorButton" id="btn_t_stroke_color"><property name="tooltip-text">Text Stroke Color</property><property name="rgba">rgb(0,0,0)</property></object></child>
                                      </object>
                                    </child>

                                    <!-- Preset bar -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <!-- Preset select/save actions -->
                                        <child>
                                          <object class="GtkBox">
                                            <style><class name="linked"/></style>
                                            <property name="hexpand">true</property>
                                            <child>
                                              <object class="GtkButton" id="btn_edit_preset">
                                                <property name="icon-name">edit-symbolic</property>
                                                <property name="tooltip-text">Rename Preset</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkDropDown" id="drop_presets">
                                                <property name="hexpand">true</property>
                                                <property name="model">
                                                  <object class="GtkStringList">
                                                    <items>
                                                      <item>Default Preset</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="btn_apply_preset">
                                                <property name="icon-name">checkmark-symbolic</property>
                                                <property name="tooltip-text">Save &amp; Apply Preset</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="btn_add_preset">
                                                <property name="icon-name">list-add-symbolic</property>
                                                <property name="tooltip-text">Add New Preset</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="btn_remove_preset">
                                                <property name="icon-name">user-trash-symbolic</property>
                                                <property name="tooltip-text">Delete Current Preset</property>
                                                <style><class name="destructive-action"/></style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>

                                        <!-- Preset import/export -->
                                        <child>
                                          <object class="GtkBox">
                                            <style><class name="linked"/></style>
                                             <child>
                                               <object class="GtkButton" id="btn_import_preset">
                                                 <property name="icon-name">arrow-pointing-away-from-line-up-symbolic</property>
                                                 <property name="tooltip-text">Import Preset</property>
                                               </object>
                                             </child>
                                             <child>
                                               <object class="GtkButton" id="btn_export_preset">
                                                 <property name="icon-name">export-symbolic</property>
                                                 <property name="tooltip-text">Export Preset</property>
                                               </object>
                                              </child>
                                            </object>
                                          </child>
                                        </object>
                                      </child>

                                     <!-- Decoration image -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="halign">3</property> <!-- End-aligned -->
                                        <property name="margin-top">12</property>
                                        <child>
                                          <object class="GtkPicture" id="img_decoration">
                                            <property name="file">resource:///com/cobaltty/stampy/prof-teto.png</property>
                                            <property name="tooltip-text">prof teto is here!</property>
                                            <property name="height-request">45</property>
                                            <property name="content-fit">1</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                      </object>
                    </child>

                    <!-- Terminal output -->
                    <child>
                      <object class="GtkFrame">
                        <style><class name="card"/></style>
                        <property name="height-request">180</property>
                        <child>
                          <object class="GtkScrolledWindow">
                            <child>
                              <object class="GtkTextView" id="txt_terminal_output">
                                <property name="editable">false</property>
                                <property name="monospace">true</property>
                                <property name="wrap-mode">3</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">8</property>
                                <property name="margin-start">8</property>
                                <property name="margin-end">8</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>

              </object>


            </child>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>
