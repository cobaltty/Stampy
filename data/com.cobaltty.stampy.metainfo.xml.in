<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.cobaltty.stampy</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Stampy</name>
  <summary>Batch-stamp photos with compass and text overlays</summary>
  <description>
    <p>Stampy stamps hundreds of photos at once with compass roses and text taken from your data files — built for field documentation such as site surveys.</p>
    <p>Overlay a compass rose per photo matched to its azimuth, watermark text per photo id from a DOCX file, and coordinates plus heading from an XLSX table. Exports run in parallel with original EXIF preserved and GPS written back.</p>
    <p>Note: Stampy is a specialized tool for compass/DOCX/XLSX field workflows and may not suit general photo editing.</p>
  </description>

  <developer id="com.cobaltty.stampy">
    <name>cobaltty</name>
  </developer>

  <url type="homepage">https://github.com/cobaltty/Stampy</url>
  <url type="vcs-browser">https://github.com/cobaltty/Stampy</url>
  <url type="bugtracker">https://github.com/cobaltty/Stampy/issues</url>

  <translation type="gettext">stampy</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">com.cobaltty.stampy.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://example.org/example1.png</image>
      <caption>A caption</caption>
    </screenshot>
    <screenshot>
      <image>https://example.org/example2.png</image>
      <caption>A caption</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.5.000.beta" date="2026-10-16">
      <description>
        <p>Preferences, persistent settings, and export thread controls.</p>
        <p>Changes:</p>
        <ul>
          <li>New Preferences dialog in the hamburger menu (Ctrl+,) with export settings</li>
          <li>JPEG compress quality with slider and typeable value</li>
          <li>Preferences, compass folder and lock, and the selected preset are remembered across restarts</li>
          <li>Export thread controls: use all CPU cores automatically or set a manual worker count</li>
        </ul>
        <p>Fixes:</p>
        <ul>
          <li>Fixed a crash when closing the Preferences dialog</li>
          <li>Fixed a crash on startup in the settings loader</li>
          <li>Fixed settings and the selected preset being reset on startup</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
